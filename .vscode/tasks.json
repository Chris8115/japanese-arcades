{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Japanese Arcades: Build mod",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Task", "Build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Japanese Arcades: Run small test client",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Task", "Client"],
      "problemMatcher": []
    },
    {
      "label": "Japanese Arcades: Run full pack test client",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Task", "PackClient"],
      "problemMatcher": []
    },
    {
      "label": "Japanese Arcades: Refresh pack copy",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Task", "SyncPack"],
      "problemMatcher": []
    },
    {
      "label": "Japanese Arcades: Prepare runs and debugger",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Task", "Prepare"],
      "problemMatcher": []
    }
  ]
